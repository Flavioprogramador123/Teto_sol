{
  "name": "planosol",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "version:show": "node -p \"require('./package.json').version\"",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "test:engine": "npx --yes tsx src/engine/selfcheck.ts",
    "test:visual": ".venv/Scripts/python.exe -m pytest tests -q",
    "visual:api": ".venv/Scripts/python.exe -m uvicorn visual_engine.api:app --host 127.0.0.1 --port 8010"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
